  "Launch": {
    "additionalProperties": false,
    "properties": {
      "acknowledge_paid": {
        "const": true,
        "title": "Acknowledge Paid",
        "type": "boolean"
      },
      "cached_input_price": {
        "anyOf": [
          {
            "maximum": 1000.0,
            "minimum": 0.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Cached Input Price"
      },
      "idempotency_key": {
        "format": "uuid",
        "title": "Idempotency Key",
        "type": "string"
      },
      "input_price": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Input Price"
      },
      "max_cost_usd": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "default": "1",
        "title": "Max Cost Usd"
      },
      "max_responses": {
        "default": 40,
        "maximum": 40,
        "minimum": 1,
        "title": "Max Responses",
        "type": "integer"
      },
      "max_seconds": {
        "default": 180,
        "maximum": 180,
        "minimum": 1,
        "title": "Max Seconds",
        "type": "integer"
      },
      "max_tool_calls": {
        "default": 35,
        "maximum": 35,
        "minimum": 1,
        "title": "Max Tool Calls",
        "type": "integer"
      },
      "objective": {
        "default": "Investigate contractual billing discrepancies and shared patterns. Challenge findings with source evidence and request human review. Do not change billing.",
        "maxLength": 2000,
        "minLength": 10,
        "title": "Objective",
        "type": "string"
      },
      "output_price": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Output Price"
      }
    },
    "required": [
      "idempotency_key",
      "acknowledge_paid",
      "input_price",
      "output_price",
      "cached_input_price"
    ],
    "title": "Launch",
    "type": "object"
  },
