  "Health": {
    "properties": {
      "api_key_configured": {
        "title": "Api Key Configured",
        "type": "boolean"
      },
      "application_id": {
        "const": "ledgerline-contract-operations",
        "default": "ledgerline-contract-operations",
        "title": "Application Id",
        "type": "string"
      },
      "dataset_ready": {
        "title": "Dataset Ready",
        "type": "boolean"
      },
      "launch_available": {
        "title": "Launch Available",
        "type": "boolean"
      },
      "message": {
        "title": "Message",
        "type": "string"
      },
      "mode": {
        "enum": ["operator", "recorded"],
        "title": "Mode",
        "type": "string"
      },
      "operator_configured": {
        "title": "Operator Configured",
        "type": "boolean"
      },
      "status": {
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "status",
      "mode",
      "api_key_configured",
      "operator_configured",
      "dataset_ready",
      "launch_available",
      "message"
    ],
    "title": "Health",
    "type": "object"
  },
  "Launch": {
    "additionalProperties": false,
    "properties": {
      "acknowledge_paid": {
        "const": true,
        "title": "Acknowledge Paid",
        "type": "boolean"
      },
      "cached_input_price": {
        "anyOf": [
          {
            "maximum": 1000.0,
            "minimum": 0.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Cached Input Price"
      },
      "idempotency_key": {
        "format": "uuid",
        "title": "Idempotency Key",
        "type": "string"
      },
      "input_price": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Input Price"
      },
      "max_cost_usd": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "default": "1",
        "title": "Max Cost Usd"
      },
      "max_responses": {
        "default": 40,
        "maximum": 40,
        "minimum": 1,
        "title": "Max Responses",
        "type": "integer"
      },
      "max_seconds": {
        "default": 180,
        "maximum": 180,
        "minimum": 1,
        "title": "Max Seconds",
        "type": "integer"
      },
      "max_tool_calls": {
        "default": 35,
        "maximum": 35,
        "minimum": 1,
        "title": "Max Tool Calls",
        "type": "integer"
      },
      "objective": {
        "default": "Investigate contractual billing discrepancies and shared patterns. Challenge findings with source evidence and request human review. Do not change billing.",
        "maxLength": 2000,
        "minLength": 10,
        "title": "Objective",
        "type": "string"
      },
      "output_price": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Output Price"
      }
    },
    "required": [
      "idempotency_key",
      "acknowledge_paid",
      "input_price",
      "output_price",
      "cached_input_price"
    ],
    "title": "Launch",
    "type": "object"
  },
  "Login": {
    "additionalProperties": false,
    "properties": {
      "token": {
        "maxLength": 512,
        "minLength": 5,
        "title": "Token",
        "type": "string"
      }
    },
    "required": ["token"],
    "title": "Login",
    "type": "object"
  },
  "ReviewAction": {
    "additionalProperties": false,
    "properties": {
      "decision": {
        "enum": ["approved", "rejected", "needs_information"],
        "title": "Decision",
        "type": "string"
      },
      "expected_revision": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Expected Revision",
        "type": "string"
      },
      "expected_version": {
        "minimum": 1,
        "title": "Expected Version",
        "type": "integer"
      },
      "rationale": {
        "maxLength": 1000,
        "minLength": 5,
        "title": "Rationale",
        "type": "string"
      }
    },
    "required": ["decision", "rationale", "expected_revision", "expected_version"],
    "title": "ReviewAction",
    "type": "object"
  },
