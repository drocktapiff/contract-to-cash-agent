        "type": "integer"
      },
      "reviews": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Reviews",
        "type": "array"
      },
      "screening_complete": {
        "default": false,
        "title": "Screening Complete",
        "type": "boolean"
      },
      "status": {
        "title": "Status",
        "type": "string"
      }
    },
    "required": ["id", "mode", "status", "reason", "created_at", "period", "model"],
    "title": "RunView",
    "type": "object"
