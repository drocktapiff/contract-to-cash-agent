        "type": "string"
      },
      "model": {
        "title": "Model",
        "type": "string"
      },
      "period": {
        "title": "Period",
        "type": "string"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      },
      "report_event_sequence": {
        "default": 0,
